// pages/boutique/BoutiqueDetailPage.jsx
import React, { useEffect, useState, useRef } from 'react';
import { useParams } from 'react-router-dom';
import { useDispatch, useSelector } from 'react-redux';
import { Container, Row, Col, Card, Spinner, Tabs, Tab } from 'react-bootstrap';
import { getBoutique, addBoutiqueView } from '../../redux/actions/boutiqueAction';
import NotFound from '../../components/NotFound';
import BoutiqueHeader from '../../components/boutique/BoutiqueHeader';
import BoutiqueSidebar from '../../components/boutique/BoutiqueSidebar';
import BoutiqueFooter from '../../components/boutique/BoutiqueFooter';
import BoutiquePostsGrid from '../../components/boutique/BoutiquePostsGrid';
import { FaBoxOpen, FaInfoCircle } from 'react-icons/fa';

import DashboardTab from '../../components/boutique/tabs/DashboardTab';
import InfoTab from '../../components/boutique/tabs/InfoTab';
import ImagesTab from '../../components/boutique/tabs/ImagesTab';
import ProductsListTab from '../../components/boutique/tabs/ProductsListTab';
import AddProductTab from '../../components/boutique/tabs/AddProductTab';
import CategoriesTab from '../../components/boutique/tabs/CategoriesTab';
import OrdersTab from '../../components/boutique/tabs/OrdersTab';
import TransactionsTab from '../../components/boutique/tabs/TransactionsTab';
import SettingsTab from '../../components/boutique/tabs/SettingsTab';

const BoutiqueDetailPage = () => {
  const { id } = useParams();
  const dispatch = useDispatch();
  const { currentBoutique, loading } = useSelector(state => state.boutique);
  const { auth } = useSelector(state => state);
  const [activeImage, setActiveImage] = useState(0);
  const [activeTab, setActiveTab] = useState('produits');
  
  const hasRecordedView = useRef(false);
  const boutiqueIdRef = useRef(null);
  const lastUserIdRef = useRef(null);

  const isOwner = auth.user?._id === currentBoutique?.user?._id;

  // Cargar boutique cuando cambia el ID
  useEffect(() => {
    if (id) {
      console.log('📥 Cargando boutique:', id);
      dispatch(getBoutique(id));
      // Resetear el ref de vista cuando cambia la boutique
      hasRecordedView.current = false;
      boutiqueIdRef.current = null;
    }
  }, [id, dispatch]);

  // 🔥 RECARGAR boutique cuando cambia el usuario (mantiene contadores globales)
  useEffect(() => {
    if (id && auth.user?._id && lastUserIdRef.current !== auth.user._id) {
      console.log('🔄 Usuario cambió de', lastUserIdRef.current, 'a', auth.user._id);
      console.log('📊 Recargando boutique para actualizar estado de follow/like del nuevo usuario');
      lastUserIdRef.current = auth.user._id;
      
      // Recargar boutique con el nuevo contexto de usuario
      dispatch(getBoutique(id));
      
      // Resetear el ref de vista para permitir nueva vista si corresponde
      hasRecordedView.current = false;
    }
  }, [id, auth.user?._id, dispatch]);

  // Lógica de vista única (una vez por usuario cada 24h)
 // pages/boutique/BoutiqueDetailPage.jsx
// Lógica de vista única (ya la tienes)
useEffect(() => {
  if (currentBoutique?._id && !hasRecordedView.current) {
    if (boutiqueIdRef.current === currentBoutique._id) {
      console.log('⚠️ Misma boutique, evitando duplicado');
      return;
    }
    
    boutiqueIdRef.current = currentBoutique._id;
    hasRecordedView.current = true;
    
    const userId = auth.user?._id || 'guest';
    const viewedKey = `boutique_viewed_${currentBoutique._id}_${userId}`;
    const lastView = localStorage.getItem(viewedKey);
    const oneDayAgo = Date.now() - 24 * 60 * 60 * 1000;
    
    let shouldAddView = false;
    
    if (auth.user?._id) {
      // Usuario autenticado: solo una vez permanente
      if (!lastView) {
        shouldAddView = true;
        localStorage.setItem(viewedKey, Date.now());
        console.log('👁️ Vista única para usuario registrado');
      } else {
        console.log('⏭️ Usuario ya vio esta boutique');
      }
    } else {
      // Invitado: una vez cada 24 horas
      if (!lastView || parseInt(lastView) < oneDayAgo) {
        shouldAddView = true;
        localStorage.setItem(viewedKey, Date.now());
        console.log('👁️ Vista para invitado (primeras 24h)');
      } else {
        console.log('⏭️ Invitado ya vio en últimas 24h');
      }
    }
    
    if (shouldAddView) {
      console.log('📤 Enviando petición de vista...');
      dispatch(addBoutiqueView(currentBoutique._id));
    }
  }
}, [currentBoutique?._id, auth.user?._id, dispatch]);

  useEffect(() => {
    if (currentBoutique?.images?.length > 0) {
      setActiveImage(0);
    }
  }, [currentBoutique]);

  if (loading) {
    return (
      <Container className="text-center py-5">
        <Spinner animation="border" variant="primary" />
        <p className="mt-3">Chargement de la boutique...</p>
      </Container>
    );
  }

  if (!currentBoutique) return <NotFound />;

  const renderOwnerContent = () => {
    switch(activeTab) {
      case 'dashboard':
        return <DashboardTab boutique={currentBoutique} />;
      case 'info':
        return <InfoTab boutique={currentBoutique} />;
      case 'images':
        return <ImagesTab 
          boutique={currentBoutique} 
          activeImage={activeImage}
          setActiveImage={setActiveImage}
        />;
      case 'products-list':
        return <ProductsListTab boutique={currentBoutique} />;
      case 'add-product':
        return <AddProductTab boutique={currentBoutique} />;
      case 'categories':
        return <CategoriesTab boutique={currentBoutique} />;
      case 'orders-list':
      case 'pending-orders':
      case 'completed-orders':
        return <OrdersTab boutique={currentBoutique} type={activeTab} />;
      case 'transactions':
      case 'subscription':
        return <TransactionsTab boutique={currentBoutique} type={activeTab} />;
      case 'profile':
      case 'social':
      case 'notifications':
        return <SettingsTab boutique={currentBoutique} type={activeTab} />;
      default:
        return <DashboardTab boutique={currentBoutique} />;
    }
  };

  return (
    <div className="boutique-detail-page" style={{ backgroundColor: '#f8f9fa' }}>
      
      <BoutiqueHeader boutique={currentBoutique} />

      <Container className="mt-4">
        <Row>
          {isOwner ? (
            <Col lg={3} className="mb-4">
              <BoutiqueSidebar 
                boutique={currentBoutique}
                activeTab={activeTab}
                onTabChange={setActiveTab}
              />
            </Col>
          ) : null}

          <Col lg={isOwner ? 9 : 12}>
            <Card className="border-0 shadow-sm">
              <Card.Body>
                {isOwner ? (
                  renderOwnerContent()
                ) : (
                  <div>
                    <Tabs
                      activeKey={activeTab}
                      onSelect={(k) => setActiveTab(k)}
                      className="mb-4"
                    >
                      <Tab 
                        eventKey="produits" 
                        title={
                          <span>
                            <FaBoxOpen className="me-2" />
                            Produits ({currentBoutique.stats?.produits || 0})
                          </span>
                        }
                      >
                        <BoutiquePostsGrid boutique={currentBoutique} />
                      </Tab>
                      <Tab 
                        eventKey="infos" 
                        title={
                          <span>
                            <FaInfoCircle className="me-2" />
                            À propos
                          </span>
                        }
                      >
                        <div className="p-3">
                          <h5>Description</h5>
                          <p>{currentBoutique.description_boutique}</p>
                          
                          {currentBoutique.proprietaire && (
                            <>
                              <h5 className="mt-4">Contact</h5>
                              <p>
                                <strong>Wilaya:</strong> {currentBoutique.proprietaire.wilaya}<br />
                                <strong>Téléphone:</strong> {currentBoutique.proprietaire.telephone}<br />
                                <strong>Email:</strong> {currentBoutique.proprietaire.email}
                              </p>
                            </>
                          )}
                        </div>
                      </Tab>
                    </Tabs>
                  </div>
                )}
              </Card.Body>
            </Card>
          </Col>
        </Row>
      </Container>

      <BoutiqueFooter boutique={currentBoutique} />
    </div>
  );
};

export default BoutiqueDetailPage;