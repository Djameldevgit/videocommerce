import React, { useState, useEffect, useCallback, useMemo } from "react";
import { useDispatch, useSelector } from "react-redux";
import { useParams, useHistory, useLocation } from "react-router-dom";
import { Container, Spinner, Row, Col, Button } from "react-bootstrap";
import InfiniteScroll from "react-infinite-scroll-component";
import { Funnel } from "react-bootstrap-icons";

/* ================= COMPONENTS ================= */
import PostCard from "../../components/post-card/PostCard";
import BoutiqueCard from "../../components/boutique/BoutiquePostCard";
import SliderUnificado from "../../components/SlidersCategories/SliderUnificado";
import PaginationComponent from "../../components/PaginationComponent";
import CategoryCarousel from "../../components/SlidersCategories/CategoryCarousel";
import FilterDrawer from "./FilterDrawer";

/* ================= ACTIONS ================= */
import { getCategoryPosts } from "../../redux/actions/categoryAction";
import { getBoutiquesByCategory } from "../../redux/actions/boutiqueAction";

/* ================= UTILS ================= */
import { findSubAndArticle } from "./utils";

/* ================= SAFE URL ================= */
const buildCategoryUrl = (slug, sub, article, page) => {
  let url = `/${slug}`;
  if (sub) url += `/${sub}`;
  if (article) url += `/${article}`;
  url += `/${page}`;
  return url;
};

const CategoryPage = () => {
  const dispatch = useDispatch();
  const history = useHistory();
  const location = useLocation();

  const { slug, subSlug, articleSlug, page } = useParams();

  const isBoutique = slug === "boutiques";

  /* ================= REDUX ================= */
  const {
    categoryInfo = {},
    posts = [],
    postsLoading = false,
    hasMorePosts = true,
    pagination = {}
  } = useSelector((state) => state.category || {});

  const categoryPath =
    isBoutique && subSlug
      ? `boutiques/${subSlug}`
      : isBoutique
      ? "boutiques"
      : null;

  const boutiqueState = useSelector((state) =>
    categoryPath ? state.boutique?.boutiquesByCategory[categoryPath] : null
  );

  const boutiques = boutiqueState?.boutiques || [];
  const boutiquesLoading = useSelector((state) =>
    categoryPath ? state.boutique?.loadingByCategory[categoryPath] : false
  );
  const hasMoreBoutiques = boutiqueState?.hasMore || false;

  /* ================= STATE ================= */
  const [filters, setFilters] = useState({
    sub: subSlug || null,
    article: articleSlug || null,
    page: page ? parseInt(page) : 1
  });

  const [activeFilters, setActiveFilters] = useState({
    wilaya: "",
    commune: "",
    minPrice: null,
    maxPrice: null,
    sortBy: "recent"
  });

  const [showFilterDrawer, setShowFilterDrawer] = useState(false);
  const [allChildren, setAllChildren] = useState([]);
  const [currentSub, setCurrentSub] = useState(null);
  const [currentArticle, setCurrentArticle] = useState(null);

  const [localLoading, setLocalLoading] = useState(false);
  const [error, setError] = useState(null);

  /* ================= ITEMS ================= */
  const items = useMemo(() =>
    isBoutique ? boutiques : posts
  , [isBoutique, boutiques, posts]);

  const safeItems = useMemo(() =>
    Array.isArray(items) ? items : []
  , [items]);

  const hasMore = useMemo(() =>
    isBoutique ? hasMoreBoutiques : hasMorePosts
  , [isBoutique, hasMoreBoutiques, hasMorePosts]);

  const isLoading = localLoading || (isBoutique ? boutiquesLoading : postsLoading);

  /* ================= FIX URL INIT ================= */
  useEffect(() => {
    if (!page) {
      const safeUrl = buildCategoryUrl(
        slug,
        subSlug,
        articleSlug,
        1
      );

      history.replace(safeUrl + location.search);
    }
  }, [slug, subSlug, articleSlug, page, history, location.search]);

  /* ================= FETCH ================= */
  const fetchCategoryData = useCallback(
    async (pageOverride = null, customFilters = null) => {
      setLocalLoading(true);

      try {
        const pageToUse = pageOverride || filters.page;
        const f = customFilters || activeFilters;

        const params = [
          f.wilaya,
          f.commune,
          f.minPrice,
          f.maxPrice,
          f.sortBy
        ];

        let res;

        if (isBoutique) {
          res = await dispatch(
            getBoutiquesByCategory(
              slug,
              filters.sub,
              pageToUse,
              12,
              ...params
            )
          );
        } else {
          res = await dispatch(
            getCategoryPosts(
              slug,
              filters.sub,
              filters.article,
              pageToUse,
              12,
              ...params
            )
          );
        }

        return res;
      } catch (err) {
        setError(err.message);
      } finally {
        setLocalLoading(false);
      }
    },
    [dispatch, slug, filters, isBoutique, activeFilters]
  );

  /* ================= INIT ================= */
  useEffect(() => {
    const load = async () => {
      const res = await fetchCategoryData();

      if (res?.children) {
        setAllChildren(res.children);

        const { currentSub, currentArticle } = findSubAndArticle(
          res.children,
          filters,
          isBoutique
        );

        setCurrentSub(currentSub);
        setCurrentArticle(currentArticle);
      }
    };

    load();
  }, [fetchCategoryData]);

  /* ================= LOAD MORE ================= */
  const loadMore = useCallback(() => {
    const canLoad = isBoutique
      ? hasMoreBoutiques && !boutiquesLoading
      : hasMorePosts && !postsLoading;

    if (!canLoad) return;

    const nextPage = filters.page + 1;

    const newFilters = { ...filters, page: nextPage };
    setFilters(newFilters);

    const url = buildCategoryUrl(
      slug,
      filters.sub,
      filters.article,
      nextPage
    );

    history.push(url);

    fetchCategoryData(nextPage);
  }, [
    isBoutique,
    hasMoreBoutiques,
    boutiquesLoading,
    hasMorePosts,
    postsLoading,
    filters,
    slug,
    history,
    fetchCategoryData
  ]);

  /* ================= PAGINATION ================= */
  const handlePageChange = (newPage) => {
    const newFilters = { ...filters, page: newPage };
    setFilters(newFilters);

    const url = buildCategoryUrl(
      slug,
      filters.sub,
      filters.article,
      newPage
    );

    history.push(url);

    fetchCategoryData(newPage);
  };

  /* ================= FILTERS ================= */
  const handleApplyFilters = async (newFilters) => {
    setActiveFilters(newFilters);
    setFilters(prev => ({ ...prev, page: 1 }));

    await fetchCategoryData(1, newFilters);
  };

  /* ================= SLIDER ================= */
  const sliderItems = useMemo(() => {
    if (currentSub?.articles?.length) return currentSub.articles;
    if (allChildren.length) return allChildren;
    return categoryInfo?.children || [];
  }, [currentSub, allChildren, categoryInfo]);

  /* ================= RENDER ================= */
  return (
    <div className="category-page">

      <CategoryCarousel categorySlug={slug} />

      <Container>

        {/* SLIDER */}
        {sliderItems.length > 0 && (
          <SliderUnificado
            items={sliderItems}
            activeItem={currentArticle || currentSub}
            onItemClick={() => {}}
          />
        )}

        {/* HEADER */}
        <div className="d-flex justify-content-between mb-3">
          <h4>{isBoutique ? "Boutiques" : "Annonces"}</h4>

          <Button onClick={() => setShowFilterDrawer(true)}>
            <Funnel /> Filtres
          </Button>
        </div>

        {/* ERROR */}
        {error && <p className="text-danger">{error}</p>}

        {/* CONTENT */}
        {isLoading && safeItems.length === 0 ? (
          <Spinner />
        ) : (
          <>
            <InfiniteScroll
              dataLength={safeItems.length}
              next={loadMore}
              hasMore={hasMore}
            >
              <Row>
                {safeItems.map((item) => (
                  <Col key={item._id} md={3}>
                    {isBoutique ? (
                      <BoutiqueCard boutique={item} />
                    ) : (
                      <PostCard post={item} />
                    )}
                  </Col>
                ))}
              </Row>

              {/* LOADING ON SCROLL */}
              {isLoading && safeItems.length > 0 && (
                <div className="text-center py-3">
                  <Spinner />
                </div>
              )}
            </InfiniteScroll>

            <PaginationComponent
              currentPage={filters.page}
              totalPages={pagination.totalPages || 1}
              onPageChange={handlePageChange}
            />
          </>
        )}

      </Container>

      <FilterDrawer
        show={showFilterDrawer}
        onHide={() => setShowFilterDrawer(false)}
        onApply={handleApplyFilters}
      />
    </div>
  );
};

export default CategoryPage;